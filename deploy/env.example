# ============================================================
# 个人健康顾问助手 —— 环境变量配置
# 使用: cp deploy/env.example .env 然后填入实际值
# ⚠️ .env 文件已在 .gitignore 中，不要提交到仓库
# ============================================================

# ── 基础设施连接 ────────────────────────────────────────
DATABASE_URL=postgresql://lha:lha_dev@localhost:5432/lha?sslmode=disable
REDIS_URL=redis://localhost:6379/0
MILVUS_HOST=localhost
MILVUS_PORT=19530
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_dev
MINIO_BUCKET=lha-uploads

# ── LLM (DeepSeek) ──────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── VLM (阿里云百炼 DashScope / qwen-vl-max) ────────────
DASHSCOPE_API_KEY=sk-your-dashscope-key
VLM_MODEL=qwen-vl-max

# ── Embedding (硅基流动 / bge-m3) ───────────────────────
SILICONFLOW_API_KEY=sk-your-siliconflow-key
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ── 向量索引调参（亮点4：调参结论直接驱动生产索引，改后重建生效）──
# 由 eval/index_tuning 的 sweep 结果决定；选型/调参换模型时同步改 EMBEDDING_DIM
INDEX_M=16
INDEX_EF_CONSTRUCTION=200
INDEX_SEARCH_EF=64

# ── Reranker (siliconflow | jina | qwen) ─────────────────
RERANKER_PROVIDER=siliconflow
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Jina 配置：PROVIDER=jina，MODEL=jina-reranker-v3
# RERANKER_BASE_URL=https://api.jina.ai/v1
JINA_API_KEY=
RERANKER_TIMEOUT=30
# Qwen：千问AI平台重排接口，填写该平台的 Key
QWEN_RERANK_API_KEY=
QWEN_RERANK_MODEL=qwen3-rerank
QWEN_RERANK_BASE_URL=https://maas.qianwenaiapi.com/compatible-api/v1
QWEN_RERANK_PATH=/reranks

# ── OCR 引擎 ────────────────────────────────────────────
# dashscope | aliyun | paddle(容器化备选)
OCR_ENGINE=dashscope

# ── 阿里云 AccessKey (OCR/PDF 解析) ─────────────────────
ALIBABA_CLOUD_ACCESS_KEY_ID=your-alibaba-cloud-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-alibaba-cloud-access-key-secret

# ── PDF 解析引擎 ────────────────────────────────────────
# pdfplumber | vlm | mineru(容器化备选)
PDF_ENGINE=pdfplumber
PDF_VLM_FALLBACK=true

# ── Go 服务 ─────────────────────────────────────────────
GO_SERVER_PORT=8080
GO_SERVER_MODE=debug
GO_BASE_URL=http://localhost:8080
# JWT 签名密钥（生产至少 32 字节随机串）
JWT_SECRET=lha-dev-secret-change-in-production
# 强制业务 API 必须登录（Bearer JWT）；开发期默认 false
AUTH_REQUIRED=false
# 可选：Python 调 POST /internal/reports 时校验
# INTERNAL_API_TOKEN=

# ── Python AI 服务 ──────────────────────────────────────
GRPC_SERVER_PORT=50057
PYTHON_LOG_LEVEL=INFO
# LangGraph Checkpointer: postgres（默认，落 PG）| memory（回落）
CHECKPOINT_BACKEND=postgres
GO_BASE_URL=http://localhost:8080

# ── MCP / A2A 协议开放（Streamable HTTP）────────────────
MCP_HOST=127.0.0.1
MCP_PORT=9002
A2A_PUBLIC_BASE=http://localhost:9002
# 可选：设置后 MCP/A2A 自定义路由要求 Bearer；未设置则开发期放行
# PROTOCOL_API_TOKEN=dev-protocol-token

# ── 前端 ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080

# ── 可观测 ──────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=lha

# ── KMS (记忆加密，开发期用本地密钥) ────────────────────
KMS_KEY_DEV=dev-only-local-key-change-in-production

# ── 可选: cloudflared 对外演示 (P3) ─────────────────────
# CLOUDFLARED_TUNNEL_TOKEN=
